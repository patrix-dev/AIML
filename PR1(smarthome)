
def get_sensor_data(t, m, l, s, o):
    return {"Temperature":t, "Motion":m, "Light":l, "Smoke":s, "Occupancy":o}

def smart_home_agent(d):
    return {
        "AC": "ON" if d["Temperature"] > 30 else "OFF",
        "Lights": "ON" if d["Motion"] and d["Light"] == "Dark" else "OFF",
        "Alarm": "ON" if d["Smoke"] else "OFF",
        "Door": "LOCKED" if not d["Occupancy"] else "UNLOCKED"
    }

def display_status(d, a):
    print("\nSMART HOME STATUS REPORT")
    print("Sensors:", d)
    print("Actions:", a)

def main():
    print("SMART HOME INTELLIGENT AGENT")

    t = float(input("Temperature: "))
    m = input("Motion (yes/no): ").lower() == "yes"
    l = input("Light (Dark/Bright): ").capitalize()
    s = input("Smoke (yes/no): ").lower() == "yes"
    o = input("Occupancy (yes/no): ").lower() == "yes"

    d = get_sensor_data(t, m, l, s, o)
    a = smart_home_agent(d)
    display_status(d, a)

main()
