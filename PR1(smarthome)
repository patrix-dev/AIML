

def smart_home_agent(lux: int, temperature: float, occupied: bool) -> tuple[str, str]:
    """Return (light, fan) actions from current sensor readings."""
    if not occupied:
        return "OFF", "OFF"

    light = "ON" if lux < 300 else "OFF"
    if temperature > 30:
        fan = "HIGH"
    elif temperature > 26:
        fan = "LOW"
    else:
        fan = "OFF"
    return light, fan


def main() -> None:
    print("Smart Home Agent — Light and Fan")
    print("PEAS: Performance=comfort and low energy; Environment=one room;")
    print("      Actuators=light and fan; Sensors=lux, temperature, occupancy.\n")

    try:
        lux = int(input("Ambient light (lux): "))
        temperature = float(input("Temperature (°C): "))
        occupied = input("Is anyone in the room? (y/n): ").strip().lower() in {"y", "yes"}
        if lux < 0:
            raise ValueError("Lux cannot be negative.")

        light, fan = smart_home_agent(lux, temperature, occupied)
        print("\nAgent actions:")
        print(f"  Light: {light}")
        print(f"  Fan:   {fan}")
    except ValueError as error:
        print(f"Invalid input: {error}")


if __name__ == "__main__":
    main()
