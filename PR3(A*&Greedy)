    while goal is not None:
        path.append(goal)
        goal = parent[goal]

    return path[::-1]


def get_cost(path):
    total = 0

    for i in range(len(path) - 1):
        current = path[i]
        next_node = path[i + 1]

        for neighbor, cost in graph[current]:
            if neighbor == next_node:
                total += cost
                break

    return total


def greedy(start, goal):
    open_list = []
    heapq.heappush(open_list, (h[start], start))

    parent = {start: None}
    closed = set()

    while open_list:
