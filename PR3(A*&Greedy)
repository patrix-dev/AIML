def astar(start, goal):
    open_list = []
    heapq.heappush(open_list, (h[start], start))

    parent = {start: None}
    g = {start: 0}

    while open_list:
        f, node = heapq.heappop(open_list)

        if node == goal:
            path = get_path(parent, goal)
            return path, g[node]

        for neighbor, cost in graph[node]:
            new_g = g[node] + cost

            if neighbor not in g or new_g < g[neighbor]:
                g[neighbor] = new_g
                parent[neighbor] = node
                f = new_g + h[neighbor]

                heapq.heappush(
                    open_list,
                    (f, neighbor)
                )

    return None, None


