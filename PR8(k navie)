
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.naive_bayes import GaussianNB
from sklearn.metrics import (
    accuracy_score, precision_score, recall_score,
    f1_score, confusion_matrix, ConfusionMatrixDisplay
)

data = load_iris(as_frame=True)
df = data.frame

print(df.head())
print("Shape:", df.shape)
print("Missing values:", df.isnull().sum().sum())
print("Class distribution:")
print(df["target"].value_counts())

X = df.drop(columns=["target"])
y = df["target"]

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

dt_model = DecisionTreeClassifier(
    criterion="gini", max_depth=3, random_state=42
)

dt_model.fit(X_train, y_train)
y_pred_dt = dt_model.predict(X_test)

nb_model = GaussianNB()
nb_model.fit(X_train, y_train)
y_pred_nb = nb_model.predict(X_test)

def evaluate_model(y_true, y_pred):
    return {
        "Accuracy": accuracy_score(y_true, y_pred),
        "Precision": precision_score(
            y_true, y_pred, average="weighted", zero_division=0
        ),
        "Recall": recall_score(
            y_true, y_pred, average="weighted", zero_division=0
        ),
        "F1-Score": f1_score(
            y_true, y_pred, average="weighted", zero_division=0
        ),
        "Confusion Matrix": confusion_matrix(y_true, y_pred)
    }

dt_results = evaluate_model(y_test, y_pred_dt)
nb_results = evaluate_model(y_test, y_pred_nb)

results = pd.DataFrame({
    "Model": ["Decision Tree", "Gaussian Naïve Bayes"],
    "Accuracy": [dt_results["Accuracy"], nb_results["Accuracy"]],
    "Precision": [dt_results["Precision"], nb_results["Precision"]],
    "Recall": [dt_results["Recall"], nb_results["Recall"]],
    "F1-Score": [dt_results["F1-Score"], nb_results["F1-Score"]]
})

print("\nModel Performance Comparison")
print(results.round(4).to_string(index=False))

print("\nDecision Tree Confusion Matrix:")
print(dt_results["Confusion Matrix"])

print("\nNaïve Bayes Confusion Matrix:")
print(nb_results["Confusion Matrix"])

plt.figure(figsize=(14, 8))
plot_tree(
    dt_model,
    feature_names=X.columns,
    class_names=data.target_names,
    filled=True
)
plt.title("Decision Tree")
plt.show()

fig, axes = plt.subplots(1, 2, figsize=(11, 4.5))

ConfusionMatrixDisplay(dt_results["Confusion Matrix"]).plot(
    ax=axes[0], colorbar=False
)
axes[0].set_title("Decision Tree")

ConfusionMatrixDisplay(nb_results["Confusion Matrix"]).plot(
    ax=axes[1], colorbar=False
)
axes[1].set_title("Gaussian Naïve Bayes")

plt.tight_layout()
plt.show()
